<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Training Feedback - LMS</title>
  <link rel="stylesheet" href="/css/tailwind.output.css">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/vendor/@fortawesome/fontawesome-free/css/all.min.css">
  <script src="/js/tw-components.js"></script>
  <style>
    .feedback-admin-header {
      margin-bottom: 1.5rem;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
    }

    .feedback-admin-header h1 {
      margin: 0;
      color: #202124;
      font-size: clamp(1.5rem, 3vw, 2rem);
    }

    .feedback-admin-header p {
      max-width: 68ch;
      margin: 0.4rem 0 0;
      color: #64748B;
      line-height: 1.5;
    }

    .feedback-confidential-badge {
      flex: 0 0 auto;
      border-radius: 999px;
      background: #EEEAFE;
      color: #4931C6;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 0.75rem;
      font-size: 0.78rem;
      font-weight: 700;
    }

    .feedback-summary-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.8rem;
      margin-bottom: 1.25rem;
    }

    .feedback-summary-item {
      padding: 1rem;
      border: 1px solid #E3E7EF;
      border-radius: 12px;
      background: #fff;
    }

    .feedback-summary-item span {
      color: #64748B;
      font-size: 0.78rem;
    }

    .feedback-summary-item strong {
      display: block;
      margin-top: 0.25rem;
      color: #202124;
      font-size: 1.45rem;
      line-height: 1.15;
    }

    .feedback-filter-form {
      margin-bottom: 1.25rem;
      padding: 1rem;
      border: 1px solid #E3E7EF;
      border-radius: 12px;
      background: #fff;
      display: grid;
      grid-template-columns: minmax(180px, 1.5fr) repeat(3, minmax(140px, 1fr)) auto;
      gap: 0.65rem;
      align-items: end;
      overflow: visible;
    }

    .feedback-filter-field {
      position: relative;
      z-index: 1;
      min-width: 0;
    }

    .feedback-filter-field:focus-within {
      z-index: 8;
    }

    .feedback-filter-field label {
      display: block;
      margin-bottom: 0.35rem;
      color: #475569;
      font-size: 0.76rem;
      font-weight: 650;
    }

    .feedback-filter-field input[type="search"] {
      width: 100%;
      min-height: 42px;
      border: 2px solid #E5E7EB;
      border-radius: 8px;
      background: #fff;
      color: #202124;
      padding: 0.55rem 0.75rem;
      font: inherit;
      font-size: 0.86rem;
      font-weight: 600;
    }

    .feedback-filter-field input[type="search"]:focus {
      outline: none;
      border-color: #573FD7;
      box-shadow: 0 0 0 4px rgba(87, 63, 215, 0.12);
    }

    .feedback-filter-field .tw-dropdown {
      width: 100%;
    }

    .feedback-filter-field .tw-dropdown--compact .tw-dropdown__btn {
      min-height: 42px;
      font-size: 0.86rem;
      font-weight: 600;
    }

    .feedback-filter-actions {
      display: flex;
      gap: 0.5rem;
    }

    .feedback-filter-actions .btn {
      min-height: 42px;
      justify-content: center;
      white-space: nowrap;
    }

    .feedback-results-heading {
      margin: 0 0 0.8rem;
      color: #334155;
      font-size: 0.9rem;
      font-weight: 650;
    }

    .feedback-response-list {
      display: grid;
      gap: 0.85rem;
    }

    .feedback-response-card {
      padding: clamp(1rem, 2.5vw, 1.35rem);
      border: 1px solid #E3E7EF;
      border-radius: 14px;
      background: #fff;
    }

    .feedback-response-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .feedback-response-name {
      margin: 0;
      color: #202124;
      font-size: 1rem;
      font-weight: 700;
    }

    .feedback-response-context {
      margin: 0.25rem 0 0;
      color: #64748B;
      font-size: 0.8rem;
      line-height: 1.4;
    }

    .feedback-response-date {
      flex: 0 0 auto;
      color: #64748B;
      font-size: 0.76rem;
      white-space: nowrap;
    }

    .feedback-rating-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .feedback-rating-cell {
      padding: 0.65rem;
      border-radius: 9px;
      background: #F8FAFC;
    }

    .feedback-rating-cell span {
      display: block;
      min-height: 2.2em;
      color: #64748B;
      font-size: 0.7rem;
      line-height: 1.2;
    }

    .feedback-rating-cell strong {
      display: block;
      margin-top: 0.2rem;
      color: #3524A8;
      font-size: 1rem;
    }

    .feedback-comments-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.7rem;
      margin-top: 0.85rem;
    }

    .feedback-comment {
      min-width: 0;
      padding-top: 0.75rem;
      border-top: 1px solid #E8EAED;
    }

    .feedback-comment h3 {
      margin: 0 0 0.3rem;
      color: #475569;
      font-size: 0.74rem;
      font-weight: 700;
    }

    .feedback-comment p {
      margin: 0;
      color: #202124;
      font-size: 0.86rem;
      line-height: 1.5;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .feedback-empty-state {
      padding: 3rem 1rem;
      border: 1px dashed #CBD5E1;
      border-radius: 14px;
      background: #fff;
      color: #64748B;
      text-align: center;
    }

    .feedback-empty-state i {
      display: flex;
      align-items: center;
      justify-content: center;
      width: max-content;
      margin: 0 auto 0.65rem;
      color: #8B7DE3;
      font-size: 1.6rem;
    }

    .feedback-pagination {
      margin-top: 1.2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .feedback-pagination p {
      margin: 0;
      color: #64748B;
      font-size: 0.82rem;
    }

    .feedback-pagination-actions {
      display: flex;
      gap: 0.5rem;
    }

    @media (max-width: 1024px) {
      .feedback-summary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .feedback-filter-form {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .feedback-filter-actions {
        grid-column: 1 / -1;
      }

      .feedback-rating-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .feedback-comments-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .feedback-admin-header,
      .feedback-response-header,
      .feedback-pagination {
        align-items: flex-start;
        flex-direction: column;
      }

      .feedback-filter-form,
      .feedback-summary-grid,
      .feedback-rating-grid {
        grid-template-columns: 1fr;
      }

      .feedback-filter-actions,
      .feedback-filter-actions .btn,
      .feedback-pagination-actions,
      .feedback-pagination-actions .btn {
        width: 100%;
      }

      .feedback-pagination-actions .btn {
        justify-content: center;
      }

      .feedback-response-date {
        white-space: normal;
      }
    }
  </style>
</head>
<body class="has-sidebar">
  <%- include('../partials/sidebar', { user }) %>
  <%
    const paceLabels = { too_slow: 'Too slow', about_right: 'About right', too_fast: 'Too fast' };
    const buildPageUrl = pageNumber => {
      const query = new URLSearchParams();
      if (filters.trainingId) query.set('training', filters.trainingId);
      if (filters.rating) query.set('rating', filters.rating);
      if (filters.pace) query.set('pace', filters.pace);
      if (filters.search) query.set('search', filters.search);
      query.set('page', String(pageNumber));
      return `/feedback?${query.toString()}`;
    };
  %>
  <main class="main-content">
    <div class="container">
      <div class="feedback-admin-header">
        <div>
          <h1>Training feedback</h1>
          <p>Review confidential trainee responses and identify improvements across training content, facilitation, pace, and practical confidence.</p>
        </div>
        <span class="feedback-confidential-badge"><i class="fas fa-shield-halved" aria-hidden="true"></i> Admin only</span>
      </div>

      <section class="feedback-summary-grid" aria-label="Feedback summary">
        <div class="feedback-summary-item"><span>Responses</span><strong><%= Number(summary.response_count || 0) %></strong></div>
        <div class="feedback-summary-item"><span>Overall rating</span><strong><%= summary.average_overall || '—' %><%= summary.average_overall ? '/5' : '' %></strong></div>
        <div class="feedback-summary-item"><span>Content relevance</span><strong><%= summary.average_content || '—' %><%= summary.average_content ? '/5' : '' %></strong></div>
        <div class="feedback-summary-item"><span>Trainer effectiveness</span><strong><%= summary.average_trainer || '—' %><%= summary.average_trainer ? '/5' : '' %></strong></div>
        <div class="feedback-summary-item"><span>Practical confidence</span><strong><%= summary.average_confidence || '—' %><%= summary.average_confidence ? '/5' : '' %></strong></div>
      </section>

      <form class="feedback-filter-form" method="get" action="/feedback">
        <div class="feedback-filter-field">
          <label for="feedback-search">Search</label>
          <input type="search" id="feedback-search" name="search" value="<%= filters.search %>" placeholder="Trainee, email, ID, or training">
        </div>
        <div class="feedback-filter-field">
          <label id="feedback-training-label" for="feedback-training-filter">Training</label>
          <input type="hidden" id="feedback-training-value" name="training" value="<%= filters.trainingId %>">
          <div id="feedback-training-dropdown" class="tw-dropdown tw-dropdown--compact"></div>
        </div>
        <div class="feedback-filter-field">
          <label id="feedback-rating-label" for="feedback-rating-filter">Overall rating</label>
          <input type="hidden" id="feedback-rating-value" name="rating" value="<%= filters.rating %>">
          <div id="feedback-rating-dropdown" class="tw-dropdown tw-dropdown--compact"></div>
        </div>
        <div class="feedback-filter-field">
          <label id="feedback-pace-label" for="feedback-pace-filter">Pace</label>
          <input type="hidden" id="feedback-pace-value" name="pace" value="<%= filters.pace %>">
          <div id="feedback-pace-dropdown" class="tw-dropdown tw-dropdown--compact"></div>
        </div>
        <div class="feedback-filter-actions">
          <button type="submit" class="btn btn-primary"><i class="fas fa-filter" aria-hidden="true"></i> Filter</button>
          <a href="/feedback" class="btn btn-outline">Clear</a>
        </div>
      </form>

      <p class="feedback-results-heading"><%= pagination.totalResponses %> matching response<%= pagination.totalResponses === 1 ? '' : 's' %></p>

      <% if (!responses.length) { %>
        <div class="feedback-empty-state">
          <i class="far fa-comment-dots" aria-hidden="true"></i>
          <strong>No feedback found</strong>
          <p>Responses will appear here after trainees submit their training reviews.</p>
        </div>
      <% } else { %>
        <div class="feedback-response-list">
          <% responses.forEach(response => { %>
            <article class="feedback-response-card">
              <header class="feedback-response-header">
                <div>
                  <h2 class="feedback-response-name"><%= response.first_name %> <%= response.last_name %></h2>
                  <p class="feedback-response-context"><%= response.trainee_public_id %> · <%= response.training_title %><%= response.healthcare_name ? ` · ${response.healthcare_name}` : '' %></p>
                </div>
                <time class="feedback-response-date" datetime="<%= new Date(response.submitted_at).toISOString() %>"><%= new Date(response.submitted_at).toLocaleString() %></time>
              </header>
              <div class="feedback-rating-grid">
                <div class="feedback-rating-cell"><span>Overall</span><strong><%= response.overall_rating %>/5</strong></div>
                <div class="feedback-rating-cell"><span>Content relevance</span><strong><%= response.content_relevance_rating %>/5</strong></div>
                <div class="feedback-rating-cell"><span>Trainer effectiveness</span><strong><%= response.trainer_effectiveness_rating %>/5</strong></div>
                <div class="feedback-rating-cell"><span>Practical confidence</span><strong><%= response.practical_confidence_rating %>/5</strong></div>
                <div class="feedback-rating-cell"><span>Pace</span><strong><%= paceLabels[response.pace] || response.pace %></strong></div>
              </div>
              <% if (response.most_valuable || response.improvement_suggestions || response.additional_comments) { %>
                <div class="feedback-comments-grid">
                  <% if (response.most_valuable) { %><section class="feedback-comment"><h3>Most valuable</h3><p><%= response.most_valuable %></p></section><% } %>
                  <% if (response.improvement_suggestions) { %><section class="feedback-comment"><h3>Could improve</h3><p><%= response.improvement_suggestions %></p></section><% } %>
                  <% if (response.additional_comments) { %><section class="feedback-comment"><h3>Additional comments</h3><p><%= response.additional_comments %></p></section><% } %>
                </div>
              <% } %>
            </article>
          <% }); %>
        </div>
      <% } %>

      <% if (pagination.totalPages > 1) { %>
        <nav class="feedback-pagination" aria-label="Feedback pages">
          <p>Page <%= pagination.page %> of <%= pagination.totalPages %></p>
          <div class="feedback-pagination-actions">
            <% if (pagination.page > 1) { %><a class="btn btn-outline" href="<%= buildPageUrl(pagination.page - 1) %>">Previous</a><% } %>
            <% if (pagination.page < pagination.totalPages) { %><a class="btn btn-outline" href="<%= buildPageUrl(pagination.page + 1) %>">Next</a><% } %>
          </div>
        </nav>
      <% } %>
    </div>
  </main>
  <script src="/js/main.js"></script>
  <script>
    (function () {
      function bindDropdown(containerId, hiddenId, buttonId, labelledBy, config) {
        new TailwindDropdown(containerId, {
          items: config.items,
          placeholder: config.placeholder,
          multiSelect: false,
          initialValue: config.initialValue || '',
          onChange: function (value) {
            var hidden = document.getElementById(hiddenId);
            if (hidden) hidden.value = value || '';
          }
        });

        var button = document.querySelector('#' + containerId + ' .tw-dropdown__btn');
        if (!button) return;
        button.id = buttonId;
        button.setAttribute('aria-labelledby', labelledBy);
      }

      bindDropdown('feedback-training-dropdown', 'feedback-training-value', 'feedback-training-filter', 'feedback-training-label', {
        placeholder: 'All trainings',
        initialValue: <%- JSON.stringify(String(filters.trainingId || '')) %>,
        items: <%- JSON.stringify([{ label: 'All trainings', value: '' }].concat((trainingOptions || []).map(function (training) {
          return { label: training.title, value: String(training.id) };
        }))) %>
      });

      bindDropdown('feedback-rating-dropdown', 'feedback-rating-value', 'feedback-rating-filter', 'feedback-rating-label', {
        placeholder: 'All ratings',
        initialValue: <%- JSON.stringify(String(filters.rating || '')) %>,
        items: [
          { label: 'All ratings', value: '' },
          { label: '5/5', value: '5' },
          { label: '4/5', value: '4' },
          { label: '3/5', value: '3' },
          { label: '2/5', value: '2' },
          { label: '1/5', value: '1' }
        ]
      });

      bindDropdown('feedback-pace-dropdown', 'feedback-pace-value', 'feedback-pace-filter', 'feedback-pace-label', {
        placeholder: 'Any pace',
        initialValue: <%- JSON.stringify(String(filters.pace || '')) %>,
        items: [
          { label: 'Any pace', value: '' },
          { label: 'Too slow', value: 'too_slow' },
          { label: 'About right', value: 'about_right' },
          { label: 'Too fast', value: 'too_fast' }
        ]
      });
    })();
  </script>
</body>
</html>
