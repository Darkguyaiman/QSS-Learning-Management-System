        display: none;
      }
      
      .data-table {
        display: table;
      }
    }
  </style>
</head>
<body class="has-sidebar">
  <%- include('../partials/sidebar', { user }) %>
  <%
    const activeDashboardDateRange = dashboardDateRange || {};
    const selectedHealthcareId = activeFilters && activeFilters.healthcareId ? String(activeFilters.healthcareId) : '';
    const selectedModuleId = activeFilters && activeFilters.moduleId ? String(activeFilters.moduleId) : '';
    const selectedDurationOperator = activeFilters && activeFilters.durationOperator ? activeFilters.durationOperator : 'gt';
    const selectedDurationHours = activeFilters && activeFilters.durationHours !== null ? String(activeFilters.durationHours) : '';
    const selectedParticipantsOperator = activeFilters && activeFilters.participantsOperator ? activeFilters.participantsOperator : 'gt';
    const selectedParticipantCount = activeFilters && activeFilters.participantCount !== null ? String(activeFilters.participantCount) : '';
    const selectedHealthcareItem = (allHealthcare || []).find(item => String(item.id) === selectedHealthcareId);
    const selectedModuleItem = (allModules || []).find(item => String(item.id) === selectedModuleId);
    const comparisonLabels = { gt: 'More than', lt: 'Less than', eq: 'Exactly' };
    const dateRangeLabel = activeDashboardDateRange.preset === 'all_time'
      ? 'All time'
      : activeDashboardDateRange.startDate && activeDashboardDateRange.endDate
      ? `${new Date(activeDashboardDateRange.startDate + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })} - ${new Date(activeDashboardDateRange.endDate + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`
      : 'This month';
    const dashboardPdfParams = [`preset=${encodeURIComponent(activeDashboardDateRange.preset || 'this_month')}`];
    if (activeDashboardDateRange.preset !== 'all_time' && activeDashboardDateRange.startDate && activeDashboardDateRange.endDate) {
      dashboardPdfParams.push(`startDate=${encodeURIComponent(activeDashboardDateRange.startDate)}`);
      dashboardPdfParams.push(`endDate=${encodeURIComponent(activeDashboardDateRange.endDate)}`);
    }
    if (selectedHealthcareId) {
      dashboardPdfParams.push(`healthcare=${encodeURIComponent(selectedHealthcareId)}`);
    }
    if (selectedModuleId) {
      dashboardPdfParams.push(`module=${encodeURIComponent(selectedModuleId)}`);
    }
    if (selectedDurationHours) {
      dashboardPdfParams.push(`durationOp=${encodeURIComponent(selectedDurationOperator)}`);
      dashboardPdfParams.push(`durationHours=${encodeURIComponent(selectedDurationHours)}`);
    }
    if (selectedParticipantCount) {
      dashboardPdfParams.push(`participantsOp=${encodeURIComponent(selectedParticipantsOperator)}`);
      dashboardPdfParams.push(`participants=${encodeURIComponent(selectedParticipantCount)}`);
    }
    const dashboardPdfUrl = `/dashboard/pdf?${dashboardPdfParams.join('&')}`;
  %>
  
  <main class="main-content">
    <div class="container">
      <div class="dashboard-header">
        <div class="dashboard-header-content">
          <h1>
            <%= isAdmin ? 'Admin Dashboard' : 'Dashboard' %>
          </h1>
          <p class="welcome-message">
            Welcome back, <span class="user-name"><%= user.userName %></span>!
          </p>
        </div>
        <div class="dashboard-header-actions">
          <button type="button" class="date-range-trigger" id="date-range-open" aria-haspopup="dialog" aria-controls="date-range-panel">
            <i class="fas fa-calendar-alt"></i>
            <span id="date-range-trigger-label"><%= dateRangeLabel %></span>
          </button>
          <div class="report-download-control" id="dashboard-report-control">
            <div class="report-download-group" role="group" aria-label="Download dashboard report">
              <button type="button" class="report-format-trigger" id="dashboard-report-format" aria-haspopup="listbox" aria-expanded="false" aria-controls="dashboard-report-format-menu">
                <i class="fas fa-file-pdf" id="dashboard-report-format-icon" aria-hidden="true"></i>
                <span id="dashboard-report-format-label">PDF</span>
                <i class="fas fa-chevron-down report-format-chevron" aria-hidden="true"></i>
              </button>
              <a href="<%= dashboardPdfUrl %>" class="btn btn-primary report-download-btn" id="dashboard-report-download" aria-label="Download dashboard report as PDF">
                <i class="fas fa-download" aria-hidden="true"></i>
                <span>Download</span>
              </a>
            </div>
            <div class="report-format-menu" id="dashboard-report-format-menu" role="listbox" aria-label="Report format" aria-hidden="true">
              <button type="button" class="report-format-option" role="option" aria-selected="true" tabindex="-1" data-format="pdf" data-url="<%= dashboardPdfUrl %>" data-icon="fa-file-pdf">
                <span class="report-format-option-icon"><i class="fas fa-file-pdf" aria-hidden="true"></i></span>
                <span class="report-format-option-copy">
                  <span class="report-format-option-title">PDF document</span>
                  <span class="report-format-option-meta">Ready to print or share</span>
                </span>
                <i class="fas fa-check report-format-option-check" aria-hidden="true"></i>
              </button>
              <button type="button" class="report-format-option" role="option" aria-selected="false" tabindex="-1" data-format="excel" data-url="<%= dashboardPdfUrl.replace('/pdf?', '/excel?') %>" data-icon="fa-file-excel">
                <span class="report-format-option-icon"><i class="fas fa-file-excel" aria-hidden="true"></i></span>
                <span class="report-format-option-copy">
                  <span class="report-format-option-title">Excel workbook</span>
                  <span class="report-format-option-meta">Editable tables and sheets</span>
                </span>
                <i class="fas fa-check report-format-option-check" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <a href="/training/create" class="btn btn-primary">Create Training</a>
        </div>
      </div>

      <div class="date-range-overlay" id="date-range-overlay" hidden></div>
      <aside class="date-range-panel" id="date-range-panel" role="dialog" aria-modal="true" aria-labelledby="date-range-title" hidden>
        <div class="date-range-panel-header">
          <button type="button" class="date-range-close" id="date-range-close" aria-label="Close filters panel">
            <i class="fas fa-chevron-left"></i>
          </button>
          <h2 class="date-range-panel-title" id="date-range-title">Dashboard filters</h2>
        </div>

        <div class="date-range-panel-body">
          <div class="date-range-presets" id="date-range-presets">
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="all_time"> All time</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="today"> Today</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="yesterday"> Yesterday</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="last_7_days"> Last 7 days</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="last_14_days"> Last 14 days</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="last_28_days"> Last 28 days</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="last_30_days"> Last 30 days</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="this_week"> This week</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="last_week"> Last week</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="this_month"> This month</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="last_month"> Last month</label>
            <label class="date-range-option"><input type="radio" name="dashboardPreset" value="custom"> Custom</label>
          </div>

          <div class="date-range-workspace">
            <div class="date-range-toolbar">
              <button type="button" class="date-range-soft-btn" id="date-range-clear">Clear</button>
              <button type="button" class="date-range-soft-btn" id="date-range-today">Today</button>
              <button type="button" class="date-range-icon-btn" id="date-range-prev-month" aria-label="Previous month">
                <i class="fas fa-chevron-left"></i>
              </button>
              <button type="button" class="date-range-icon-btn" id="date-range-next-month" aria-label="Next month">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>

            <div class="date-range-calendars" id="date-range-calendars"></div>

            <div class="date-input-row">
              <button type="button" class="date-display-trigger is-active" id="panel-start-date-btn" data-boundary="start">
                <span class="date-display-value" id="panel-start-date-value"></span>
                <i class="far fa-calendar"></i>
              </button>
              <button type="button" class="date-display-trigger" id="panel-end-date-btn" data-boundary="end">
                <span class="date-display-value" id="panel-end-date-value"></span>
                <i class="far fa-calendar"></i>
              </button>
            </div>
            <p class="date-range-helper" id="date-range-helper">Pick a start date, then an end date from the calendar.</p>

            <div class="panel-filter-grid">
              <div class="panel-filter-group">
                <label class="panel-filter-label" for="panel-healthcare-trigger">Healthcare</label>
                <div class="panel-custom-select" data-custom-select data-searchable="true">
                  <input type="hidden" class="panel-custom-select-value" id="panel-healthcare-filter" value="<%= selectedHealthcareId %>">
                  <button type="button" class="panel-custom-select-trigger" id="panel-healthcare-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="panel-healthcare-menu">
                    <span class="panel-custom-select-value-label"><%= selectedHealthcareItem ? selectedHealthcareItem.name : 'All healthcare' %></span>
                    <i class="fas fa-chevron-down panel-custom-select-chevron" aria-hidden="true"></i>
                  </button>
                  <div class="panel-custom-select-menu" id="panel-healthcare-menu" hidden>
                    <div class="panel-custom-select-search-wrap">
                      <i class="fas fa-search" aria-hidden="true"></i>
                      <input type="search" class="panel-custom-select-search" placeholder="Search healthcare..." aria-label="Search healthcare">
                    </div>
                    <div class="panel-custom-select-options" role="listbox" aria-label="Healthcare options">
                      <button type="button" class="panel-custom-select-option <%= selectedHealthcareId ? '' : 'is-selected' %>" role="option" aria-selected="<%= selectedHealthcareId ? 'false' : 'true' %>" data-value="" data-label="All healthcare"><span>All healthcare</span><i class="fas fa-check" aria-hidden="true"></i></button>
                      <% (allHealthcare || []).forEach(item => { const isSelected = String(item.id) === selectedHealthcareId; %>
                        <button type="button" class="panel-custom-select-option <%= isSelected ? 'is-selected' : '' %>" role="option" aria-selected="<%= isSelected ? 'true' : 'false' %>" data-value="<%= item.id %>" data-label="<%= item.name %>"><span><%= item.name %></span><i class="fas fa-check" aria-hidden="true"></i></button>
                      <% }); %>
                    </div>
                    <p class="panel-custom-select-empty" hidden>No healthcare matches your search.</p>
                  </div>
                </div>
              </div>
              <div class="panel-filter-group">
                <label class="panel-filter-label" for="panel-module-trigger">Module</label>
                <div class="panel-custom-select" data-custom-select>
                  <input type="hidden" class="panel-custom-select-value" id="panel-module-filter" value="<%= selectedModuleId %>">
                  <button type="button" class="panel-custom-select-trigger" id="panel-module-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="panel-module-menu">
                    <span class="panel-custom-select-value-label"><%= selectedModuleItem ? selectedModuleItem.name : 'All modules' %></span>
                    <i class="fas fa-chevron-down panel-custom-select-chevron" aria-hidden="true"></i>
                  </button>
                  <div class="panel-custom-select-menu" id="panel-module-menu" hidden>
                    <div class="panel-custom-select-options" role="listbox" aria-label="Module options">
                      <button type="button" class="panel-custom-select-option <%= selectedModuleId ? '' : 'is-selected' %>" role="option" aria-selected="<%= selectedModuleId ? 'false' : 'true' %>" data-value="" data-label="All modules"><span>All modules</span><i class="fas fa-check" aria-hidden="true"></i></button>
                      <% (allModules || []).forEach(item => { const isSelected = String(item.id) === selectedModuleId; %>
                        <button type="button" class="panel-custom-select-option <%= isSelected ? 'is-selected' : '' %>" role="option" aria-selected="<%= isSelected ? 'true' : 'false' %>" data-value="<%= item.id %>" data-label="<%= item.name %>"><span><%= item.name %></span><i class="fas fa-check" aria-hidden="true"></i></button>
                      <% }); %>
                    </div>
                  </div>
                </div>
              </div>
              <div class="panel-filter-group">
                <label class="panel-filter-label" for="panel-duration-operator-trigger">Training duration</label>
                <div class="panel-threshold-control">
                  <div class="panel-custom-select" data-custom-select>
                    <input type="hidden" class="panel-custom-select-value" id="panel-duration-operator" value="<%= selectedDurationOperator %>">
                    <button type="button" class="panel-custom-select-trigger" id="panel-duration-operator-trigger" aria-label="Duration comparison" aria-haspopup="listbox" aria-expanded="false" aria-controls="panel-duration-operator-menu">
                      <span class="panel-custom-select-value-label"><%= comparisonLabels[selectedDurationOperator] %></span>
                      <i class="fas fa-chevron-down panel-custom-select-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="panel-custom-select-menu" id="panel-duration-operator-menu" hidden>
                      <div class="panel-custom-select-options" role="listbox" aria-label="Duration comparison options">
                        <% Object.entries(comparisonLabels).forEach(([value, label]) => { const isSelected = value === selectedDurationOperator; %>
                          <button type="button" class="panel-custom-select-option <%= isSelected ? 'is-selected' : '' %>" role="option" aria-selected="<%= isSelected ? 'true' : 'false' %>" data-value="<%= value %>" data-label="<%= label %>"><span><%= label %></span><i class="fas fa-check" aria-hidden="true"></i></button>
                        <% }); %>
                      </div>
                    </div>
                  </div>
                  <div class="panel-input-wrap">
                    <input class="panel-filter-input" id="panel-duration-value" type="number" min="0" step="0.25" inputmode="decimal" value="<%= selectedDurationHours %>" placeholder="Any" aria-describedby="duration-filter-hint">
                    <span class="panel-input-unit">hours</span>
                  </div>
                </div>
                <div class="panel-quick-values" aria-label="Quick duration values">
                  <button type="button" class="panel-quick-value" data-filter-target="panel-duration-value" data-filter-value="2">2h</button>
                  <button type="button" class="panel-quick-value" data-filter-target="panel-duration-value" data-filter-value="4">4h</button>
                  <button type="button" class="panel-quick-value" data-filter-target="panel-duration-value" data-filter-value="8">8h</button>
                </div>
                <p class="panel-filter-hint" id="duration-filter-hint">Leave empty to include any duration.</p>
              </div>
              <div class="panel-filter-group">
                <label class="panel-filter-label" for="panel-participants-operator-trigger">Participants</label>
                <div class="panel-threshold-control">
                  <div class="panel-custom-select" data-custom-select>
                    <input type="hidden" class="panel-custom-select-value" id="panel-participants-operator" value="<%= selectedParticipantsOperator %>">
                    <button type="button" class="panel-custom-select-trigger" id="panel-participants-operator-trigger" aria-label="Participant count comparison" aria-haspopup="listbox" aria-expanded="false" aria-controls="panel-participants-operator-menu">
                      <span class="panel-custom-select-value-label"><%= comparisonLabels[selectedParticipantsOperator] %></span>
                      <i class="fas fa-chevron-down panel-custom-select-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="panel-custom-select-menu" id="panel-participants-operator-menu" hidden>
                      <div class="panel-custom-select-options" role="listbox" aria-label="Participant comparison options">
                        <% Object.entries(comparisonLabels).forEach(([value, label]) => { const isSelected = value === selectedParticipantsOperator; %>
                          <button type="button" class="panel-custom-select-option <%= isSelected ? 'is-selected' : '' %>" role="option" aria-selected="<%= isSelected ? 'true' : 'false' %>" data-value="<%= value %>" data-label="<%= label %>"><span><%= label %></span><i class="fas fa-check" aria-hidden="true"></i></button>
                        <% }); %>
                      </div>
                    </div>
                  </div>
                  <div class="panel-input-wrap">
                    <input class="panel-filter-input" id="panel-participants-value" type="number" min="0" step="1" inputmode="numeric" value="<%= selectedParticipantCount %>" placeholder="Any" aria-describedby="participants-filter-hint">
                    <span class="panel-input-unit">people</span>
                  </div>
                </div>
                <div class="panel-quick-values" aria-label="Quick participant values">
                  <button type="button" class="panel-quick-value" data-filter-target="panel-participants-value" data-filter-value="10">10</button>
                  <button type="button" class="panel-quick-value" data-filter-target="panel-participants-value" data-filter-value="25">25</button>
                  <button type="button" class="panel-quick-value" data-filter-target="panel-participants-value" data-filter-value="50">50</button>
                </div>
                <p class="panel-filter-hint" id="participants-filter-hint">Counts distinct enrolled trainees.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="date-range-panel-footer">
          <button type="button" class="btn btn-outline" id="date-range-cancel">Cancel</button>
          <button type="button" class="btn btn-primary" id="date-range-apply">Filter</button>
        </div>
      </aside>
      
      <!-- Quick Actions -->
      <div class="quick-actions dashboard-section" style="margin-bottom: 2rem;">
        <h2><i class="fas fa-bolt" style="color: #573FD7;"></i> Quick Actions</h2>
        <div class="action-cards">
          <a href="/training" class="action-card">
            <div class="card-image">
              <img src="/images/Dashboard Images/Trainings.webp" alt="Trainings">
            </div>
            <div class="card-content">
              <h3>Manage Trainings</h3>
              <p>View and manage all training programs</p>
            </div>
          </a>
          
          <a href="/trainees" class="action-card">
            <div class="card-image">
              <img src="/images/Dashboard Images/Trainees.webp" alt="Trainees">
            </div>
            <div class="card-content">
              <h3>Trainees</h3>
              <p>View and manage all trainees</p>
            </div>
          </a>
          
          <a href="/questions" class="action-card">
            <div class="card-image">
              <img src="/images/Dashboard Images/Questions.webp" alt="Questions">
            </div>
            <div class="card-content">
              <h3>Questions</h3>
              <p>Manage training questions and answers</p>
            </div>
          </a>
        </div>
      </div>
      
      <!-- Trainings Section -->
      <section class="dashboard-section">
        <h2><i class="fas fa-graduation-cap" style="color: #573FD7;"></i> Trainings</h2>
        
        <div class="stats-grid">
          <div class="stat-card">
            <h3><%= trainingStats.total %></h3>
            <p>Total Trainings</p>
          </div>
          <div class="stat-card">
            <h3><%= trainingStats.in_progress ?? 0 %></h3>
            <p>In Progress</p>
          </div>
          <div class="stat-card">
            <h3><%= trainingStats.completed ?? 0 %></h3>
            <p>Completed</p>
          </div>
          <div class="stat-card">
            <h3><%= trainingStats.canceled ?? 0 %></h3>
            <p>Canceled</p>
          </div>
          <div class="stat-card">
            <h3><%= trainingStats.rescheduled ?? 0 %></h3>
            <p>Rescheduled</p>
          </div>
          <div class="stat-card">
            <h3><%= trainingStats.course_completion_rate ?? 0 %>%</h3>
            <p>Course Completion Rate</p>
          </div>
          <div class="stat-card">
            <h3><%= trainingStats.assessment_pass_rate ?? 0 %>%</h3>
            <p>Assessment Pass Rate</p>
          </div>
        </div>
        
        <div class="recent-trainings-header" style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <h3 style="margin: 0; color: #202124; font-size: 1.25rem; font-weight: 600;">
            <i class="fas fa-clock" style="color: #573FD7; margin-right: 0.5rem;"></i>
            Recent Trainings
          </h3>
          <span class="recent-trainings-subtitle" style="color: #5F6368; font-size: 0.875rem;">
            Showing latest 10 trainings
          </span>
        </div>
        
        <div class="table-responsive">
          <!-- Desktop Table View -->
          <table class="data-table">
            <thead>
              <tr>
                <th>Training Title</th>
                <th>Training Type</th>
                <th>Start Date & Time</th>
                <th>End Date & Time</th>
                <th>Participating Healthcare Centres</th>
                <th>Device Serial Numbers</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentTrainings.length === 0) { %>
                <tr>
                  <td colspan="7" style="text-align: center; padding: 2rem; color: #5F6368;">
                    No trainings found
                  </td>
                </tr>
              <% } else { %>
                <% recentTrainings.forEach(training => { %>
                  <tr>
                    <td><strong><%= training.title %></strong></td>
                    <td>
                      <span class="badge badge-<%= training.type %>">
                        Main
                      </span>
                    </td>
                    <td>
                      <%= training.start_datetime 
                        ? new Date(training.start_datetime).toLocaleString('en-US', { 
                            year: 'numeric', 
                            month: 'short', 
                            day: 'numeric', 
                            hour: '2-digit', 
                            minute: '2-digit' 
                          })
                        : '-' %>
                    </td>
                    <td>
                      <%= training.end_datetime 
                        ? new Date(training.end_datetime).toLocaleString('en-US', { 
                            year: 'numeric', 
                            month: 'short', 
                            day: 'numeric', 
                            hour: '2-digit', 
                            minute: '2-digit' 
                          })
                        : '-' %>
                    </td>
                    <td>
                      <% if (training.healthcare_centres) { %>
                        <div class="chip-container">
                          <% training.healthcare_centres.split(', ').forEach(hc => { %>
                            <span class="chip chip-healthcare"><%= hc %></span>
                          <% }); %>
                        </div>
                      <% } else { %>
                        <span style="color: #9CA3AF;">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (training.device_serial_numbers) { %>
                        <div class="chip-container">
                          <% training.device_serial_numbers.split(', ').forEach(device => { %>
                            <span class="chip chip-device"><%= device %></span>
                          <% }); %>
                        </div>
                      <% } else { %>
                        <span style="color: #9CA3AF;">-</span>
                      <% } %>
                    </td>
                    <td>
                      <% 
                        const statusLabels = {
                          'in_progress': 'In Progress',
                          'completed': 'Completed',
                          'canceled': 'Canceled',
                          'rescheduled': 'Rescheduled'
                        };
                        const statusClass = `status-${training.status.replace('_', '-')}`;
                      %>
                      <span class="status-badge <%= statusClass %>">
                        <%= statusLabels[training.status] || training.status.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
                      </span>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
          
          <!-- Mobile/Tablet Card View -->
          <div class="table-card-grid">
            <% if (recentTrainings.length === 0) { %>
              <div class="table-card" style="text-align: center; padding: 2rem; color: #5F6368;">
                No trainings found
              </div>
            <% } else { %>
              <% recentTrainings.forEach(training => { %>
                <% 
                  const statusLabels = {
                    'in_progress': 'In Progress',
                    'completed': 'Completed',
                    'canceled': 'Canceled',
                    'rescheduled': 'Rescheduled'
                  };
                  const statusClass = `status-${training.status.replace('_', '-')}`;
                %>
                <div class="table-card">
                  <div class="table-card-header">
                    <h3 class="table-card-title"><%= training.title %></h3>
                    <span class="status-badge <%= statusClass %>">
                      <%= statusLabels[training.status] || training.status.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
                    </span>
                  </div>
                  <div class="table-card-body">
                    <div class="table-card-row">
                      <div class="table-card-label">Training Type</div>
                      <div class="table-card-value">
                        <span class="badge badge-<%= training.type %>">
                          Main
                        </span>
                      </div>
