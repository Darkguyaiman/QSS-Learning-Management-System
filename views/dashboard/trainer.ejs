  </main>
  
  <script src="/vendor/chart.js/dist/chart.umd.js"></script>
  <script>
    (() => {
      const topClientTrainings = <%- JSON.stringify((topClientTrainings || []).map(client => ({
        name: client.name || 'Unknown Client',
        training_count: Number(client.training_count || 0)
      }))) %>;
      const chartCanvas = document.getElementById('top-clients-chart');

      if (!chartCanvas || !window.Chart || topClientTrainings.length === 0) return;

      const labels = topClientTrainings.map(client => client.name);
      const counts = topClientTrainings.map(client => client.training_count);

      new Chart(chartCanvas, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'Trainings',
            data: counts,
            backgroundColor: 'rgba(87, 63, 215, 0.78)',
            borderColor: '#573FD7',
            borderWidth: 1,
            borderRadius: 6,
            barThickness: 16,
            maxBarThickness: 18
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              callbacks: {
                label: context => `${context.parsed.x} training${context.parsed.x === 1 ? '' : 's'}`
              }
            }
          },
          scales: {
            x: {
              beginAtZero: true,
              ticks: {
                precision: 0
              },
              grid: {
                color: 'rgba(148, 163, 184, 0.22)'
              }
            },
            y: {
              ticks: {
                color: '#374151',
                font: {
                  size: 11,
                  weight: '400'
                },
                callback(value) {
                  const label = this.getLabelForValue(value);
                  return label.length > 28 ? `${label.slice(0, 28)}...` : label;
                }
              },
              grid: {
                display: false
              }
            }
          }
        }
      });
    })();
  </script>
  <script>
    (() => {
      const initialRange = <%- JSON.stringify(dashboardDateRange || {}) %>;
      const openButton = document.getElementById('date-range-open');
      const overlay = document.getElementById('date-range-overlay');
      const panel = document.getElementById('date-range-panel');
      const closeButton = document.getElementById('date-range-close');
      const cancelButton = document.getElementById('date-range-cancel');
      const applyButton = document.getElementById('date-range-apply');
      const clearButton = document.getElementById('date-range-clear');
      const todayButton = document.getElementById('date-range-today');
      const prevButton = document.getElementById('date-range-prev-month');
      const nextButton = document.getElementById('date-range-next-month');
      const calendars = document.getElementById('date-range-calendars');
      const startButton = document.getElementById('panel-start-date-btn');
      const endButton = document.getElementById('panel-end-date-btn');
      const startValue = document.getElementById('panel-start-date-value');
      const endValue = document.getElementById('panel-end-date-value');
      const healthcareSelect = document.getElementById('panel-healthcare-filter');
      const moduleSelect = document.getElementById('panel-module-filter');
      const durationOperator = document.getElementById('panel-duration-operator');
      const durationValue = document.getElementById('panel-duration-value');
      const participantsOperator = document.getElementById('panel-participants-operator');
      const participantsValue = document.getElementById('panel-participants-value');
      const quickValueButtons = Array.from(document.querySelectorAll('.panel-quick-value'));
      const customSelectRoots = Array.from(document.querySelectorAll('[data-custom-select]'));
      const customSelectApis = new Map();
      const presetInputs = Array.from(document.querySelectorAll('input[name="dashboardPreset"]'));

      const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' });
      const displayDateFormatter = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      const presets = {
        today: () => {
          const today = startOfDay(new Date());
          return [today, today];
        },
        yesterday: () => {
          const day = addDays(startOfDay(new Date()), -1);
          return [day, day];
        },
        last_7_days: () => rangeEndingToday(6),
        last_14_days: () => rangeEndingToday(13),
        last_28_days: () => rangeEndingToday(27),
        last_30_days: () => rangeEndingToday(29),
        this_week: () => {
          const today = startOfDay(new Date());
          const mondayOffset = (today.getDay() || 7) - 1;
          const start = addDays(today, -mondayOffset);
          return [start, addDays(start, 6)];
        },
        last_week: () => {
          const today = startOfDay(new Date());
          const mondayOffset = (today.getDay() || 7) - 1;
          const end = addDays(today, -mondayOffset - 1);
          return [addDays(end, -6), end];
        },
        this_month: () => {
          const today = new Date();
          return [new Date(today.getFullYear(), today.getMonth(), 1), new Date(today.getFullYear(), today.getMonth() + 1, 0)];
        },
        last_month: () => {
          const today = new Date();
          return [new Date(today.getFullYear(), today.getMonth() - 1, 1), new Date(today.getFullYear(), today.getMonth(), 0)];
        }
      };

      let selectedStart = parseDate(initialRange.startDate) || presets.this_month()[0];
      let selectedEnd = parseDate(initialRange.endDate) || presets.this_month()[1];
      let activePreset = initialRange.preset || 'this_month';
      let visibleMonth = new Date(selectedStart.getFullYear(), selectedStart.getMonth(), 1);
      let activeBoundary = 'start';

      function startOfDay(date) {
        return new Date(date.getFullYear(), date.getMonth(), date.getDate());
      }

      function addDays(date, days) {
        const next = new Date(date);
        next.setDate(next.getDate() + days);
        return next;
      }

      function rangeEndingToday(offsetDays) {
        const end = startOfDay(new Date());
        return [addDays(end, -offsetDays), end];
      }

      function parseDate(value) {
        if (!value) return null;
        const parts = String(value).split('-').map(Number);
        if (parts.length !== 3 || parts.some(Number.isNaN)) return null;
        return new Date(parts[0], parts[1] - 1, parts[2]);
      }

      function formatDate(date) {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      }

      function formatDisplayDate(date) {
        return date ? displayDateFormatter.format(date) : '';
      }

      function closeCustomSelects(exceptRoot = null) {
        customSelectApis.forEach((api, root) => {
          if (root !== exceptRoot) api.close(false);
        });
      }

      function initializeCustomSelect(root) {
        const hiddenInput = root.querySelector('.panel-custom-select-value');
        const trigger = root.querySelector('.panel-custom-select-trigger');
        const triggerLabel = root.querySelector('.panel-custom-select-value-label');
        const menu = root.querySelector('.panel-custom-select-menu');
        const search = root.querySelector('.panel-custom-select-search');
        const emptyMessage = root.querySelector('.panel-custom-select-empty');
        const options = Array.from(root.querySelectorAll('.panel-custom-select-option'));

        const visibleOptions = () => options.filter(option => !option.hidden);

        const filterOptions = query => {
          const normalizedQuery = String(query || '').trim().toLocaleLowerCase();
          let matchCount = 0;
          options.forEach(option => {
            const matches = !normalizedQuery || option.dataset.label.toLocaleLowerCase().includes(normalizedQuery);
            option.hidden = !matches;
            if (matches) matchCount += 1;
          });
          if (emptyMessage) emptyMessage.hidden = matchCount > 0;
        };

        const close = (returnFocus = false) => {
          if (menu.hidden) return;
          root.classList.remove('is-open');
          menu.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
          if (returnFocus) trigger.focus();
        };

        const open = () => {
          if (!menu.hidden) return;
          closeCustomSelects(root);
          root.classList.add('is-open');
          menu.hidden = false;
          trigger.setAttribute('aria-expanded', 'true');
          if (search) {
            search.value = '';
            filterOptions('');
            requestAnimationFrame(() => search.focus());
          } else {
            const selectedOption = options.find(option => option.classList.contains('is-selected')) || options[0];
            requestAnimationFrame(() => selectedOption?.focus());
          }
        };

        const setValue = (value, { returnFocus = true } = {}) => {
          const nextOption = options.find(option => option.dataset.value === String(value)) || options[0];
          if (!nextOption) return;
          hiddenInput.value = nextOption.dataset.value;
          triggerLabel.textContent = nextOption.dataset.label;
          options.forEach(option => {
            const isSelected = option === nextOption;
            option.classList.toggle('is-selected', isSelected);
            option.setAttribute('aria-selected', String(isSelected));
          });
          hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
          close(returnFocus);
        };

        trigger.addEventListener('click', () => {
          if (menu.hidden) open();
          else close(true);
        });

        trigger.addEventListener('keydown', event => {
          if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(event.key)) {
            event.preventDefault();
            open();
          }
        });

        options.forEach(option => {
          option.tabIndex = -1;
          option.addEventListener('click', () => setValue(option.dataset.value));
        });

        menu.addEventListener('keydown', event => {
          if (event.key === 'Escape') {
            event.preventDefault();
            event.stopPropagation();
            close(true);
            return;
          }

          if (search && event.target === search && event.key === 'ArrowDown') {
            event.preventDefault();
            visibleOptions()[0]?.focus();
            return;
          }

          if (!event.target.classList.contains('panel-custom-select-option')) return;
          const availableOptions = visibleOptions();
          const currentIndex = availableOptions.indexOf(event.target);
          let nextIndex = currentIndex;
          const navigationKeys = ['ArrowDown', 'ArrowUp', 'Home', 'End'];
          if (!navigationKeys.includes(event.key)) return;
          event.preventDefault();
          if (event.key === 'ArrowDown') nextIndex = Math.min(currentIndex + 1, availableOptions.length - 1);
          if (event.key === 'ArrowUp') nextIndex = Math.max(currentIndex - 1, 0);
          if (event.key === 'Home') nextIndex = 0;
          if (event.key === 'End') nextIndex = availableOptions.length - 1;
          if (nextIndex !== currentIndex) {
            availableOptions[nextIndex]?.focus();
          }
        });

        if (search) {
          search.addEventListener('input', () => filterOptions(search.value));
        }

        root.addEventListener('focusout', () => {
          window.setTimeout(() => {
            if (!root.contains(document.activeElement)) close(false);
          }, 0);
        });

        return { root, close, open, setValue };
      }

      customSelectRoots.forEach(root => {
        customSelectApis.set(root, initializeCustomSelect(root));
      });

      function setCustomSelectValue(input, value) {
        if (!input) return;
        const root = input.closest('[data-custom-select]');
        const api = customSelectApis.get(root);
        if (api) api.setValue(value, { returnFocus: false });
      }

      function applyPreset(preset) {
        activePreset = preset;
        if (preset === 'all_time') {
          activeBoundary = 'start';
        } else if (presets[preset]) {
          [selectedStart, selectedEnd] = presets[preset]();
          visibleMonth = new Date(selectedStart.getFullYear(), selectedStart.getMonth(), 1);
          activeBoundary = 'start';
        }
        syncControls();
      }

      function syncControls() {
        if (selectedStart && selectedEnd && selectedStart > selectedEnd) {
          [selectedStart, selectedEnd] = [selectedEnd, selectedStart];
        }

        startValue.textContent = activePreset === 'all_time' ? 'All time' : formatDisplayDate(selectedStart);
        endValue.textContent = activePreset === 'all_time' ? 'All time' : formatDisplayDate(selectedEnd);
        startButton.classList.toggle('is-active', activeBoundary === 'start');
        endButton.classList.toggle('is-active', activeBoundary === 'end');

        presetInputs.forEach(input => {
          input.checked = input.value === activePreset;
        });

        renderCalendars();
      }

      function renderCalendars() {
        calendars.innerHTML = '';
        calendars.appendChild(renderMonth(visibleMonth));
        calendars.appendChild(renderMonth(new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1)));
      }

      function renderMonth(monthDate) {
        const calendar = document.createElement('div');
        calendar.className = 'date-calendar';

        const title = document.createElement('h3');
        title.textContent = monthFormatter.format(monthDate);
        calendar.appendChild(title);

        const grid = document.createElement('div');
        grid.className = 'date-calendar-grid';
        ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].forEach(day => {
          const weekday = document.createElement('div');
          weekday.className = 'date-calendar-weekday';
          weekday.textContent = day;
          grid.appendChild(weekday);
        });

        const firstDay = new Date(monthDate.getFullYear(), monthDate.getMonth(), 1);
        const blanks = (firstDay.getDay() || 7) - 1;
        const daysInMonth = new Date(monthDate.getFullYear(), monthDate.getMonth() + 1, 0).getDate();

        for (let index = 0; index < blanks; index += 1) {
          const blank = document.createElement('span');
          blank.className = 'date-calendar-day is-muted';
          grid.appendChild(blank);
        }

        for (let day = 1; day <= daysInMonth; day += 1) {
          const date = new Date(monthDate.getFullYear(), monthDate.getMonth(), day);
          const button = document.createElement('button');
          button.type = 'button';
          button.className = getDayClass(date);
          button.textContent = String(day);
          button.addEventListener('click', () => selectCalendarDate(date));
          grid.appendChild(button);
        }

        calendar.appendChild(grid);
        return calendar;
      }

      function getDayClass(date) {
        const dayValue = formatDate(date);
        const startValue = activePreset === 'all_time' ? null : selectedStart ? formatDate(selectedStart) : null;
        const endValue = activePreset === 'all_time' ? null : selectedEnd ? formatDate(selectedEnd) : null;
        const classes = ['date-calendar-day'];

        if (dayValue === startValue || dayValue === endValue) {
          classes.push('is-selected');
        } else if (startValue && endValue && dayValue > startValue && dayValue < endValue) {
          classes.push('is-in-range');
        }

        return classes.join(' ');
      }

      function selectCalendarDate(date) {
        activePreset = 'custom';
        if (activeBoundary === 'start') {
          selectedStart = startOfDay(date);
          if (!selectedEnd || selectedStart > selectedEnd) {
            selectedEnd = selectedStart;
          }
          activeBoundary = 'end';
        } else {
          selectedEnd = startOfDay(date);
          if (!selectedStart || selectedEnd < selectedStart) {
            selectedStart = selectedEnd;
          }
          activeBoundary = 'start';
        }
        syncControls();
      }

      function openPanel() {
        overlay.hidden = false;
        panel.hidden = false;
        requestAnimationFrame(() => {
          overlay.classList.add('is-open');
          panel.classList.add('is-open');
        });
      }

      function closePanel() {
        closeCustomSelects();
        overlay.classList.remove('is-open');
        panel.classList.remove('is-open');
        window.setTimeout(() => {
          overlay.hidden = true;
          panel.hidden = true;
        }, 240);
      }

      function applyFilter() {
        if ((durationValue && !durationValue.checkValidity()) || (participantsValue && !participantsValue.checkValidity())) {
          const invalidInput = [durationValue, participantsValue].find(input => input && !input.checkValidity());
          invalidInput.reportValidity();
          invalidInput.focus();
          return;
        }

        const url = new URL(window.location.href);
        url.searchParams.set('preset', activePreset || 'custom');
        if (activePreset === 'all_time') {
          url.searchParams.delete('startDate');
          url.searchParams.delete('endDate');
        } else {
          if (!selectedStart || !selectedEnd) return;
          url.searchParams.set('startDate', formatDate(selectedStart));
          url.searchParams.set('endDate', formatDate(selectedEnd));
        }
        if (healthcareSelect && healthcareSelect.value) {
          url.searchParams.set('healthcare', healthcareSelect.value);
        } else {
          url.searchParams.delete('healthcare');
        }
        if (moduleSelect && moduleSelect.value) {
          url.searchParams.set('module', moduleSelect.value);
        } else {
          url.searchParams.delete('module');
        }
        if (durationValue && durationValue.value !== '') {
          url.searchParams.set('durationOp', durationOperator.value);
          url.searchParams.set('durationHours', durationValue.value);
        } else {
          url.searchParams.delete('durationOp');
          url.searchParams.delete('durationHours');
        }
        if (participantsValue && participantsValue.value !== '') {
          url.searchParams.set('participantsOp', participantsOperator.value);
          url.searchParams.set('participants', participantsValue.value);
        } else {
          url.searchParams.delete('participantsOp');
          url.searchParams.delete('participants');
        }
        window.location.href = url.toString();
      }

      presetInputs.forEach(input => {
        input.addEventListener('change', () => applyPreset(input.value));
      });

      startButton.addEventListener('click', () => {
        activeBoundary = 'start';
        syncControls();
      });

      endButton.addEventListener('click', () => {
        activeBoundary = 'end';
        syncControls();
      });

      openButton.addEventListener('click', openPanel);
      closeButton.addEventListener('click', closePanel);
      cancelButton.addEventListener('click', closePanel);
      overlay.addEventListener('click', closePanel);
      applyButton.addEventListener('click', applyFilter);
      quickValueButtons.forEach(button => {
        button.addEventListener('click', () => {
          const input = document.getElementById(button.dataset.filterTarget);
          if (!input) return;
          input.value = button.dataset.filterValue;
          input.focus();
        });
      });
      document.addEventListener('pointerdown', event => {
        customSelectApis.forEach(api => {
          if (!api.root.contains(event.target)) api.close(false);
        });
      });
      clearButton.addEventListener('click', () => {
        applyPreset('this_month');
        setCustomSelectValue(healthcareSelect, '');
        setCustomSelectValue(moduleSelect, '');
        setCustomSelectValue(durationOperator, 'gt');
        if (durationValue) durationValue.value = '';
        setCustomSelectValue(participantsOperator, 'gt');
        if (participantsValue) participantsValue.value = '';
      });
      todayButton.addEventListener('click', () => applyPreset('today'));
      prevButton.addEventListener('click', () => {
        visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1);
        renderCalendars();
      });
      nextButton.addEventListener('click', () => {
        visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1);
        renderCalendars();
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && panel.classList.contains('is-open')) {
          closePanel();
        }
      });

      syncControls();
    })();
  </script>
  <script>
    (() => {
      const control = document.getElementById('dashboard-report-control');
      const formatTrigger = document.getElementById('dashboard-report-format');
      const formatMenu = document.getElementById('dashboard-report-format-menu');
      const formatLabel = document.getElementById('dashboard-report-format-label');
      const formatIcon = document.getElementById('dashboard-report-format-icon');
      const downloadLink = document.getElementById('dashboard-report-download');
      const options = Array.from(document.querySelectorAll('.report-format-option'));
      if (!control || !formatTrigger || !formatMenu || !formatLabel || !formatIcon || !downloadLink || !options.length) return;

      const browserTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (browserTimeZone) {
        options.forEach(option => {
          const reportUrl = new URL(option.dataset.url, window.location.origin);
          reportUrl.searchParams.set('timeZone', browserTimeZone);
          option.dataset.url = `${reportUrl.pathname}${reportUrl.search}`;
        });
        const selectedOption = options.find(option => option.getAttribute('aria-selected') === 'true') || options[0];
        downloadLink.href = selectedOption.dataset.url;
      }

      const isOpen = () => formatTrigger.getAttribute('aria-expanded') === 'true';

      const openMenu = (focusIndex = null) => {
        formatTrigger.setAttribute('aria-expanded', 'true');
        formatMenu.setAttribute('aria-hidden', 'false');
        formatMenu.classList.add('is-open');
        const selectedIndex = options.findIndex(option => option.getAttribute('aria-selected') === 'true');
        options[focusIndex ?? Math.max(selectedIndex, 0)].focus();
      };

      const closeMenu = (restoreFocus = false) => {
        formatTrigger.setAttribute('aria-expanded', 'false');
        formatMenu.setAttribute('aria-hidden', 'true');
        formatMenu.classList.remove('is-open');
        if (restoreFocus) formatTrigger.focus();
      };

      const selectFormat = option => {
        options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
        const isExcel = option.dataset.format === 'excel';
        formatLabel.textContent = isExcel ? 'Excel' : 'PDF';
        formatIcon.className = `fas ${option.dataset.icon}`;
        downloadLink.href = option.dataset.url;
        downloadLink.setAttribute('aria-label', `Download dashboard report as ${isExcel ? 'Excel' : 'PDF'}`);
        closeMenu(true);
      };

      formatTrigger.addEventListener('click', () => {
        if (isOpen()) closeMenu();
        else openMenu();
      });

      formatTrigger.addEventListener('keydown', event => {
        if (['ArrowDown', 'Enter', ' '].includes(event.key)) {
          event.preventDefault();
          if (!isOpen()) openMenu();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          if (!isOpen()) openMenu(options.length - 1);
        } else if (event.key === 'Escape' && isOpen()) {
          event.preventDefault();
          closeMenu(true);
        }
      });

      options.forEach((option, index) => {
        option.addEventListener('click', () => selectFormat(option));
        option.addEventListener('keydown', event => {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            const direction = event.key === 'ArrowDown' ? 1 : -1;
            options[(index + direction + options.length) % options.length].focus();
          } else if (event.key === 'Home' || event.key === 'End') {
            event.preventDefault();
            options[event.key === 'Home' ? 0 : options.length - 1].focus();
          } else if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            selectFormat(option);
          } else if (event.key === 'Escape') {
            event.preventDefault();
            closeMenu(true);
          } else if (event.key === 'Tab') {
            closeMenu();
          }
        });
      });

      document.addEventListener('pointerdown', event => {
        if (isOpen() && !control.contains(event.target)) closeMenu();
      });
    })();
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
